{
  "name": "example-expo",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "expo": "~57.0.24",
    "expo-build-properties": "~57.0.21",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-arrangement-view": "workspace:*",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios --device \"iPhone Duo\"",
    "android": "expo run:android --device Pixel_10_Pro_Fold",
    "build:ios": "xcodebuild ONLY_ACTIVE_ARCH=YES -workspace ios/ArrangementViewExample.xcworkspace -UseNewBuildSystem=YES -scheme ArrangementViewExample -configuration Debug -sdk iphonesimulator -derivedDataPath ios/build -quiet",
    "build:android": "cd android && ./gradlew assembleDebug -PreactNativeArchitectures=arm64-v8a --no-daemon --console=plain"
  },
  "private": true,
  "devDependencies": {
    "react-native-builder-bob": "^0.43.1",
    "react-native-monorepo-config": "^0.4.0"
  }
}
