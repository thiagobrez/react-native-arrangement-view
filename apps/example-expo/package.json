{
  "name": "example-expo",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@bottom-tabs/react-navigation": "^1.4.0",
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-vector-icons/material-design-icons": "^13.1.4",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "expo": "~57.0.24",
    "expo-build-properties": "~57.0.21",
    "expo-symbols": "~57.0.3",
    "expo-video": "~57.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-arrangement-view": "workspace:*",
    "react-native-bottom-tabs": "^1.4.0",
    "react-native-pager-view": "8.0.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios --device \"iPhone Duo\"",
    "android": "expo run:android --device Pixel_10_Pro_Fold",
    "ios:release": "expo run:ios --device \"iPhone Duo\" --configuration Release --no-bundler",
    "android:release": "expo run:android --device Pixel_10_Pro_Fold --variant release --no-bundler",
    "build:ios": "xcodebuild ONLY_ACTIVE_ARCH=YES -workspace ios/ArrangementViewExample.xcworkspace -UseNewBuildSystem=YES -scheme ArrangementViewExample -configuration Debug -sdk iphonesimulator -derivedDataPath ios/build -quiet",
    "build:android": "cd android && ./gradlew assembleDebug -PreactNativeArchitectures=arm64-v8a --no-daemon --console=plain",
    "test:e2e:ios": "e2e run --target ios",
    "test:e2e:android": "e2e run --target android"
  },
  "private": true,
  "devDependencies": {
    "@e2e-dev/mobile": "patch:@e2e-dev/mobile@npm%3A0.10.0#~/.yarn/patches/@e2e-dev-mobile-npm-0.10.0-fef61f6f0f.patch",
    "e2e": "^0.18.0",
    "react-native-builder-bob": "^0.43.1",
    "react-native-monorepo-config": "^0.4.0"
  }
}
