{
  "name": "react-native-arrangement-view",
  "version": "0.1.0",
  "description": "Foldable-aware adaptive arrangements and hinge observation for React Native",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-arrangement-view-source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace example-expo",
    "clean": "del-cli lib",
    "prepare": "bob build",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "build": "bob build",
    "test": "node --test tests/*.test.ts",
    "version-packages": "changeset version && yarn install --no-immutable",
    "publish-packages": "yarn lint && yarn typecheck && yarn test && yarn build && changeset publish"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "swiftui",
    "jetpack-windowmanager",
    "arrangement",
    "foldable",
    "hinge"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thiagobrez/react-native-arrangement-view.git"
  },
  "author": "Thiago Brezinski <thiagobrez@gmail.com> (https://github.com/thiagobrez)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/thiagobrez/react-native-arrangement-view/issues"
  },
  "homepage": "https://github.com/thiagobrez/react-native-arrangement-view#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@types/node": "^24",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.0.0",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-builder-bob": "^0.43.1",
    "react-test-renderer": "19.2.3",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.83.0"
  },
  "workspaces": [
    ".",
    "apps/*"
  ],
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "RNArrangementViewSpec",
    "type": "components",
    "jsSrcsDir": "src",
    "ios": {
      "components": {
        "RNArrangementView": {
          "className": "RNArrangementView"
        },
        "RNArrangementPane": {
          "className": "RNArrangementPane"
        }
      }
    },
    "android": {
      "javaPackageName": "com.arrangementview"
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "create-react-native-library": {
    "type": "fabric-view",
    "languages": "kotlin-objc",
    "tools": [
      "eslint"
    ],
    "version": "0.63.1"
  }
}
