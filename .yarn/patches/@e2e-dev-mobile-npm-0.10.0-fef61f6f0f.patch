+
+const execFileAsync = promisify(execFile);
+/** Hinge angle per pose, and the name of the device state Android's foldable emulators report for it. */
+const EMULATOR_POSES = {
+    closed: { angle: 0, state: 'CLOSED' },
+    'half-open': { angle: 90, state: 'HALF_OPENED' },
+    open: { angle: 180, state: 'OPENED' },
+};
+/** The SDK's adb, else the one on PATH. */
+function adbPath() {
+    const sdk = process.env['ANDROID_HOME'] ?? process.env['ANDROID_SDK_ROOT'];
+    const adb = sdk === undefined ? undefined : path.join(sdk, 'platform-tools', 'adb');
+    return adb !== undefined && existsSync(adb) ? adb : 'adb';
+}
