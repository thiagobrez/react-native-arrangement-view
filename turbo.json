{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".nvmrc",
    ".yarnrc.yml"
  ],
  "globalEnv": [
    "NODE_ENV"
  ],
  "tasks": {
    "build:ios": {
      "env": [
        "RCT_NEW_ARCH_ENABLED",
        "RCT_REMOVE_LEGACY_ARCH",
        "RCT_USE_RN_DEP",
        "RCT_USE_PREBUILT_RNCORE"
      ],
      "inputs": [
        "package.json",
        "*.podspec",
        "ios",
        "src/*.ts",
        "src/*.tsx",
        "apps/example-expo/package.json",
        "apps/example-expo/ios",
        "!apps/example-expo/ios/build",
        "!apps/example-expo/ios/Pods"
      ],
      "outputs": []
    }
  }
}
